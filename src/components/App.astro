---
import type { GetStaticPaths } from "astro";
import SnowFlakes from "./SnowFlakes.astro";
import DottingTitle from "./DottingTitle.astro";
import SnowBorder from "./SnowBorder.astro";
import GiftApp from "./GiftApp.vue";
---
<div id="app">
<div class="snowflake-wrapper">
  <SnowFlakes />
</div>
<SnowBorder/>
<DottingTitle/>
<GiftApp client:load />
</div>

<style>
  #app {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    min-width: 100vw;
    justify-content: space-evenly;
  }
  .snowflake-wrapper {
    height: 100vh;
    width: 100vw;
    position: absolute;
    top: 0;
    left: 0;
    overflow: clip;
    pointer-events: none;
  }
</style>
