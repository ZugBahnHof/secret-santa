---
import PageWrapper from "../components/PageWrapper.astro";
import SnowBorder from "../components/SnowBorder.astro";
import { games } from "../data/games.ts";
---
<PageWrapper>
    <div id="content">
        <h1>Secret Santa</h1>

        <h2>How does it work?</h2>

        <ol>
            <li>You receive a link and a secret password.</li>
            <li>Click the link and enter the password.</li>
            <li>
                The name of a person will appear.
                You should buy a gift for them.
                There usually is a price range for the gift.
            </li>
            <li>Do not tell anybody the recipient of your gift, it's a secret!</li>
            <li>Buy and wrap the gift.</li>
            <li>At the end there is a gift exchange :)</li>
        </ol>

        <p>Have fun!</p>

        <p class="note">Btw, if you lost the link, it might be one of these:</p>

        <ul>
            {games.toReversed().map((game) => (
                <li>
                    <a href={`${game.slug}`}>{game.name}</a>
                </li>
            ))}
        </ul>
    </div>

    <SnowBorder/>
</PageWrapper>

<style>
    #content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100vh;
        background-image: radial-gradient(
                #325487 0%,
                rgba(50, 84, 135, 0) 100%
        );
        padding: 4em;
        max-width: 600px;
        margin: auto;
    }

    p.note {
        margin-top: 2em;
    }

    ul {
        flex-direction: column;
    }

    ul, ul li {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1em;
    }

    ul li a {
        text-decoration: none;
        color: #46C441;
        font-weight: 950;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        text-align: center;
        transition: all 0.3s ease;
        transform: scale(1);
    }

    ul li a:hover {
        color: #68D468;
        transform: scale(1.1);
    }

    ul li a:active {
        color: #8AF88A;
        transform: scale(0.95);
    }

    ol {
        list-style: decimal;
        padding-left: 1rem;
    }

    li {
        font-family: "Emilys Candy", Purisa, Comic Sans MS, Roboto, Montserrat, sans-serif
    }

    h1 {
        text-align: center;
        font-size: 3rem;
        margin-bottom: 2rem;
        font-weight: bold;
    }

    h2 {
        text-align: center;
        font-size: 2rem;
        margin-bottom: 1rem;
        font-weight: bold;
    }
</style>